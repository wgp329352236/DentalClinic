<!--pages/messages/messages.wxml-->
<view class="container">
  <!-- 分类标签：4 个标签可直接平铺，不用 scroll-view（enable-flex 会把子项拉伸到整页高度） -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <view class="flex-between mb-20">
    <text class="text-muted font-small">共 {{total}} 条 · 未读 {{unreadCount}} 条</text>
    <view class="mark-all" bindtap="onMarkAllRead">全部已读</view>
  </view>

  <view wx:if="{{loading && messages.length === 0}}" class="loading">加载中...</view>

  <view wx:else>
    <view
      class="card msg-item {{item.isRead ? 'read' : ''}}"
      wx:for="{{messages}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onMessageTap"
    >
      <view class="flex-between mb-10">
        <view class="msg-title">
          <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
          <text class="font-bold">{{item.title}}</text>
        </view>
        <text class="badge badge-default">{{item.typeText}}</text>
      </view>
      <view class="msg-content">{{item.content}}</view>
      <view class="text-muted font-small mt-10">{{item.createdAt}}</view>
    </view>

    <view wx:if="{{messages.length === 0}}" class="empty-state">
      <view>暂无消息</view>
    </view>

    <view wx:if="{{messages.length > 0}}" class="load-more text-muted font-small">
      {{hasMore ? (loading ? '加载中...' : '上拉加载更多') : '已加载全部'}}
    </view>
  </view>
</view>
