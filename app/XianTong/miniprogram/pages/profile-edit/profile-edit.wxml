<!--pages/profile-edit/profile-edit.wxml-->
<view class="container">
  <view class="card">
    <!-- 头像 -->
    <view class="form-row" bindtap="onChooseAvatar">
      <view class="form-label">头像</view>
      <view class="form-value avatar-cell">
        <image wx:if="{{avatar}}" class="avatar-preview" src="{{avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty">未设置</view>
        <text class="text-muted font-small">{{avatarUploading ? '上传中...' : '点击更换'}}</text>
      </view>
    </view>

    <!-- 昵称 -->
    <view class="form-row">
      <view class="form-label">昵称</view>
      <input class="form-input" value="{{nickname}}" placeholder="请输入昵称" maxlength="30" bindinput="onNicknameInput" />
    </view>

    <!-- 姓名 -->
    <view class="form-row">
      <view class="form-label">真实姓名</view>
      <input class="form-input" value="{{realName}}" placeholder="用于就诊登记" maxlength="20" bindinput="onRealNameInput" />
    </view>

    <!-- 手机号 -->
    <view class="form-row">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" value="{{phone}}" placeholder="11 位手机号" maxlength="11" bindinput="onPhoneInput" />
    </view>

    <!-- 性别 -->
    <view class="form-row">
      <view class="form-label">性别</view>
      <radio-group class="form-value" bindchange="onGenderChange">
        <label class="radio-item">
          <radio value="1" checked="{{gender === 1}}" color="#1890ff" />男
        </label>
        <label class="radio-item">
          <radio value="2" checked="{{gender === 2}}" color="#1890ff" />女
        </label>
      </radio-group>
    </view>

    <!-- 年龄 -->
    <view class="form-row">
      <view class="form-label">年龄</view>
      <input class="form-input" type="number" value="{{age}}" placeholder="选填" maxlength="3" bindinput="onAgeInput" />
    </view>
  </view>

  <view class="tip text-muted">手机号若已被其他账号使用，保存时会提示「该手机号已被其他账号使用」。</view>

  <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSave">
    {{submitting ? '保存中...' : '保存'}}
  </button>
</view>
