<!--pages/profile-edit/profile-edit.wxml-->
<view class="container">
  <view class="card">
    <!-- 头像：微信「头像填写能力」，支持从微信头像/相册选择 -->
    <view class="form-row">
      <view class="form-label">头像</view>
      <button class="form-value avatar-cell avatar-pick-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatar}}" class="avatar-preview" src="{{avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty">未设置</view>
        <text class="text-muted font-small">{{avatarUploading ? '上传中...' : '点击更换'}}</text>
      </button>
    </view>

    <!-- 昵称：优先服务端值，其次微信昵称，最后手机号后 4 位；type="nickname" 唤起微信昵称填写 -->
    <view class="form-row">
      <view class="form-label">昵称</view>
      <input class="form-input" type="nickname" value="{{nickname}}" placeholder="点击填写昵称" maxlength="30" bindinput="onNicknameInput" />
    </view>

    <!-- 姓名 -->
    <view class="form-row">
      <view class="form-label">真实姓名</view>
      <input class="form-input" value="{{realName}}" placeholder="用于就诊登记" maxlength="20" bindinput="onRealNameInput" />
    </view>

    <!-- 手机号：取自微信授权，只读；点「重新授权」可补绑或更换 -->
    <view class="form-row">
      <view class="form-label">手机号</view>
      <view class="form-value phone-cell">
        <text class="form-phone">{{phone || '未授权手机号'}}</text>
        <button class="reauth-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onReauthorizePhone" size="mini">重新授权</button>
      </view>
    </view>

    <!-- 性别 -->
    <view class="form-row">
      <view class="form-label">性别</view>
      <radio-group class="form-value" bindchange="onGenderChange">
        <label class="radio-item">
          <radio value="1" checked="{{gender === 1}}" color="#1890ff" />男
        </label>
        <label class="radio-item">
          <radio value="2" checked="{{gender === 2}}" color="#1890ff" />女
        </label>
      </radio-group>
    </view>

    <!-- 年龄 -->
    <view class="form-row">
      <view class="form-label">年龄</view>
      <input class="form-input" type="number" value="{{age}}" placeholder="选填" maxlength="3" bindinput="onAgeInput" />
    </view>

    <!-- 归属门店：首次可自行选择，设置后锁定 -->
    <view class="form-row">
      <view class="form-label">归属门店</view>
      <view wx:if="{{primaryClinicLocked}}" class="form-value clinic-value locked">
        <view class="clinic-name">{{primaryClinicName || '已设置'}}</view>
        <view class="clinic-lock-tip">已确认，如需变更请联系门店</view>
      </view>
      <picker
        wx:else
        class="form-value clinic-picker"
        mode="selector"
        range="{{clinicNames}}"
        value="{{clinicIndex}}"
        bindchange="onClinicChange"
        disabled="{{clinicNames.length === 0}}"
      >
        <view class="clinic-value {{primaryClinicId ? '' : 'placeholder'}}">
          {{primaryClinicId ? primaryClinicName : (clinicNames.length ? '请选择归属门店' : '暂无可选门店')}}
        </view>
        <text class="picker-arrow">›</text>
      </picker>
    </view>
  </view>

  <view class="tip text-muted">完善昵称、头像、姓名、性别、年龄和归属门店后，保存时可领取首次完善资料积分。手机号可点右侧「重新授权」补绑或更换。</view>

  <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSave">
    {{submitting ? '保存中...' : '保存'}}
  </button>
</view>
