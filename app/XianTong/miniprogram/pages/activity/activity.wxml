<!--pages/activity/activity.wxml-->
<view class="page">
  <view wx:if="{{loading}}" class="state">加载中...</view>

  <block wx:elif="{{activity}}">
    <image
      wx:if="{{cover}}"
      class="cover"
      src="{{cover}}"
      mode="aspectFill"
      binderror="onCoverError"
    ></image>
    <view wx:else class="cover cover-placeholder">{{activity.title}}</view>

    <view class="card intro">
      <view class="title">{{activity.title}}</view>
      <view class="summary" wx:if="{{activity.summary}}">{{activity.summary}}</view>
      <view class="period">活动时间：{{period}}</view>
    </view>

    <view class="card detail" wx:if="{{paragraphs.length > 0}}">
      <view class="section-title">活动详情</view>
      <view class="paragraph" wx:for="{{paragraphs}}" wx:key="index">{{item}}</view>
    </view>
  </block>

  <view wx:elif="{{errorMessage}}" class="state">
    <view class="state-title">{{errorMessage}}</view>
    <view class="state-tip">请检查网络后重试</view>
    <button class="retry-btn" bindtap="onRetryTap">重新加载</button>
  </view>

  <view wx:else class="state">
    <view class="state-title">活动不存在或已结束</view>
    <view class="state-tip">可以返回首页看看其他活动</view>
  </view>

  <view class="footer" wx:if="{{activity}}">
    <button class="book-btn" bindtap="onBookTap">立即预约</button>
  </view>
</view>
