<!--pages/coupon/coupon.wxml-->
<view class="container">
  <!-- 状态切换 Tab -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="onTabChange"
    >
      {{item.text}}
    </view>
  </view>

  <!-- 优惠券列表 -->
  <view class="coupon-list" wx:if="{{coupons.length > 0}}">
    <view class="coupon-card" wx:for="{{coupons}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-amount">¥{{item.amount}}</view>
        <view class="coupon-threshold">满{{item.minAmount}}元可用</view>
      </view>
      <view class="coupon-divider"></view>
      <view class="coupon-right">
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-scope">适用：{{item.scope}}</view>
        <view class="coupon-date">有效期至 {{item.validTo}}</view>
      </view>
      <view class="coupon-status badge {{item.statusCls}}">{{item.statusText}}</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-icon">🎫</view>
    <view class="empty-text">暂无{{activeTab === 'unused' ? '可用' : (activeTab === 'used' ? '已使用' : '已过期')}}优惠券</view>
  </view>
</view>
