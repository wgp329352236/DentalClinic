# ═══════════════════════════════════════════════════════════════════════════
# 生产环境变量模板（Server）
#
# 用法：
#   1. 复制到服务器：cp .env.prod.example /etc/dentalclinic/server.env
#   2. 填入真实值：  chmod 600 /etc/dentalclinic/server.env
#   3. systemd 引用：EnvironmentFile=/etc/dentalclinic/server.env
#      （systemd 会忽略 # 注释行，且不做 $() 变量展开，请直接写入字面量）
#
# 约定：
#   - APP_ENV=prod 时启动预检（StartupPreflight）会校验下列必填项，
#     任一缺失或仍为开发默认值都会直接阻断启动，不会带病上线；
#   - 本文件只保留空值模板，真实凭证禁止提交到版本库；
#   - 生成随机密钥：openssl rand -hex 32（每项独立生成，不要复用）；
#   - 本文件不支持跨行值，所有值必须写在同一行。
#
# 必填项速查（缺失即启动失败）：
#   DB_URL / DB_USERNAME / DB_PASSWORD
#   ADMIN_JWT_SECRET / USER_JWT_SECRET / CHECKIN_SIGNING_SECRET
#   PHONE_ENCRYPTION_KEY / PHONE_BLIND_INDEX_KEY
#   WECHAT_APP_ID / WECHAT_APP_SECRET
#   WECHAT_MCH_ID / WECHAT_API_V3_KEY / WECHAT_MERCHANT_SERIAL
#   WECHAT_PRIVATE_KEY_PATH / WECHAT_PAY_NOTIFY_URL
#   TENCENT_SMS_SECRET_ID / TENCENT_SMS_SECRET_KEY / TENCENT_SMS_SDK_APP_ID
#   TENCENT_SMS_SIGN_NAME / TENCENT_SMS_TEMPLATE_ID
# ═══════════════════════════════════════════════════════════════════════════

# ─── 运行环境 ───
# prod 必填：启用 application-prod.yaml、启动预检与 fail-fast
APP_ENV=prod

# ─── 数据库（PostgreSQL，注意是 R2DBC 协议前缀）───
DB_URL=r2dbc:postgresql://127.0.0.1:5432/dental_clinic
DB_USERNAME=
DB_PASSWORD=

# ─── JWT 签名密钥（管理端与用户端必须各自独立）───
ADMIN_JWT_SECRET=
USER_JWT_SECRET=

# ─── 门店签到码 HMAC 密钥 ───
# 轮换后全部门店需重新打印签到码
CHECKIN_SIGNING_SECRET=

# ─── 手机号加密存储（AES-256-GCM + HMAC 盲索引，两把密钥必须独立）───
# 轮换加密密钥前需先完成历史密文重加密，否则旧手机号无法解密
PHONE_ENCRYPTION_KEY=
PHONE_BLIND_INDEX_KEY=

# ─── 微信小程序 ───
# 微信公众平台 → 开发管理 → 开发设置
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 小程序码目标版本：release=线上版 / trial=体验版 / develop=开发版
WECHAT_WXA_ENV_VERSION=release

# ─── 微信支付 V3（商户平台 → 账户中心 → API 安全）───
WECHAT_MCH_ID=
# APIv3 密钥：商户平台自行设置的 32 位字符串
WECHAT_API_V3_KEY=
# 商户 API 证书序列号：openssl x509 -in apiclient_cert.pem -noout -serial
WECHAT_MERCHANT_SERIAL=
# 商户私钥文件绝对路径（推荐挂载文件，不要把私钥内容写进本文件）
WECHAT_PRIVATE_KEY_PATH=/opt/dentalclinic/apiclient_key.pem
# 支付结果回调：必须公网 HTTPS，且与 Nginx 反代路径一致
WECHAT_PAY_NOTIFY_URL=https://admin.example.com/api/v1/recharge/notify

# ─── 腾讯云短信（控制台 → 短信 → 应用管理 / 签名与模板）───
# 建议使用仅授权 QcloudSMSFullAccess 的子账号密钥
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
# 短信应用 SdkAppId，1400 开头
TENCENT_SMS_SDK_APP_ID=
# 已审核通过的签名内容，不含【】
TENCENT_SMS_SIGN_NAME=
# 已审核通过的正文模板 ID，模板需含验证码变量
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# ─── 推荐分享域名 ───
# 「邀请好友」落地页前缀，缺失时邀请链接为死链（仅告警，不阻断启动）
REFERRAL_SHARE_BASE_URL=https://admin.example.com

# ─── Redis（管理端登录强依赖：Refresh Token、失败锁定）───
# 由 application-prod.yaml 的 redis.* 读取，均支持环境变量注入
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# 无密码时留空即可（未设置时不拼接密码）
REDIS_PASSWORD=
