# 本地开发凭证模板 —— 复制为 .env.local 后填值（.env.local 已被 git 忽略，禁止提交）
#   cp .env.local.example .env.local && ./run-local.sh
# 取值优先级：环境变量 > application.yaml；未配置的项相关能力自动降级为 mock（启动日志 WARN）。

# ─── 运行环境（prod 会启用启动预检 fail-fast，本地保持注释）───
# APP_ENV=dev

# ─── 手机号加密存储（两个密钥必须独立）───
# 生成方式：openssl rand -hex 32
PHONE_ENCRYPTION_KEY=
PHONE_BLIND_INDEX_KEY=

# ─── 微信小程序：登录 code2session / 获取手机号 / 小程序码 ───
# 微信公众平台 → 开发管理 → 开发设置
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 小程序码目标版本：release=线上版 / trial=体验版 / develop=开发版
WECHAT_WXA_ENV_VERSION=release

# ─── 微信支付 V3（商户平台 → 账户中心 → API 安全）───
WECHAT_MCH_ID=
# APIv3 密钥：商户平台自行设置的 32 位字符串
WECHAT_API_V3_KEY=
# 商户 API 证书序列号（执行 openssl x509 -in apiclient_cert.pem -noout -serial 获取）
WECHAT_MERCHANT_SERIAL=
# 商户私钥文件绝对路径（apiclient_key.pem）。切勿把私钥内容写进任何入库文件
WECHAT_PRIVATE_KEY_PATH=
# 支付结果回调地址：必须公网 HTTPS，如 https://api.example.com/api/v1/recharge/notify
WECHAT_PAY_NOTIFY_URL=

# ─── 腾讯云短信（控制台 → 短信 → 应用管理 / 国内短信 → 签名与模板）───
# 访问管理 CAM → API 密钥管理，建议使用只授权 QcloudSMSFullAccess 的子账号密钥
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
# 短信应用 SdkAppId，1400 开头
TENCENT_SMS_SDK_APP_ID=
# 已审核通过的签名内容，不含【】（如：某某口腔）
TENCENT_SMS_SIGN_NAME=
# 已审核通过的正文模板 ID（纯数字），模板需含验证码变量如「您的验证码为{1}，5分钟内有效」
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
